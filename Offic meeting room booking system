import tkinter as tk
from tkinter import ttk, messagebox
import mysql.connector
from datetime import datetime


# ================= MYSQL CONNECTION =================

def connect_database():
    try:
        connection = mysql.connector.connect(
            host="localhost",
            user="root",
            password="YOUR_MYSQL_PASSWORD",
            database="office_meeting"
        )
        return connection

    except mysql.connector.Error as e:
        messagebox.showerror(
            "Database Error",
            f"MySQL Connection Failed:\n{e}"
        )
        return None


# ================= BOOK ROOM =================

def book_room():

    employee = employee_entry.get()
    room = room_combo.get()
    date = date_entry.get()
    start = start_entry.get()
    end = end_entry.get()
    purpose = purpose_entry.get()

    if employee == "" or room == "" or date == "" or start == "" or end == "":
        messagebox.showwarning(
            "Warning",
            "Please fill all required fields."
        )
        return

    # Check date
    try:
        datetime.strptime(date, "%Y-%m-%d")
    except ValueError:
        messagebox.showerror(
            "Error",
            "Date format must be YYYY-MM-DD"
        )
        return

    # Check time
    try:
        start_obj = datetime.strptime(start, "%H:%M")
        end_obj = datetime.strptime(end, "%H:%M")
    except ValueError:
        messagebox.showerror(
            "Error",
            "Time format must be HH:MM"
        )
        return

    if start_obj >= end_obj:
        messagebox.showerror(
            "Error",
            "End time must be greater than start time."
        )
        return

    connection = connect_database()

    if connection is None:
        return

    cursor = connection.cursor()

    # Check room availability
    query = """
        SELECT id
        FROM bookings
        WHERE room_name = %s
        AND meeting_date = %s
        AND start_time < %s
        AND end_time > %s
    """

    cursor.execute(
        query,
        (room, date, end, start)
    )

    existing_booking = cursor.fetchone()

    if existing_booking:
        messagebox.showerror(
            "Room Not Available",
            "This room is already booked for this time."
        )

        cursor.close()
        connection.close()
        return

    # Insert booking
    query = """
        INSERT INTO bookings
        (employee_name, room_name, meeting_date,
         start_time, end_time, purpose)
        VALUES (%s, %s, %s, %s, %s, %s)
    """

    values = (
        employee,
        room,
        date,
        start,
        end,
        purpose
    )

    cursor.execute(query, values)

    connection.commit()

    cursor.close()
    connection.close()

    messagebox.showinfo(
        "Success",
        "Meeting room booked successfully!"
    )

    clear_fields()
    show_bookings()


# ================= SHOW BOOKINGS =================

def show_bookings():

    for item in booking_table.get_children():
        booking_table.delete(item)

    connection = connect_database()

    if connection is None:
        return

    cursor = connection.cursor()

    cursor.execute("""
        SELECT
            id,
            employee_name,
            room_name,
            meeting_date,
            start_time,
            end_time,
            purpose
        FROM bookings
        ORDER BY meeting_date, start_time
    """)

    rows = cursor.fetchall()

    for row in rows:
        booking_table.insert(
            "",
            tk.END,
            values=row
        )

    cursor.close()
    connection.close()


# ================= SEARCH =================

def search_booking():

    search_text = search_entry.get()

    for item in booking_table.get_children():
        booking_table.delete(item)

    connection = connect_database()

    if connection is None:
        return

    cursor = connection.cursor()

    query = """
        SELECT
            id,
            employee_name,
            room_name,
            meeting_date,
            start_time,
            end_time,
            purpose
        FROM bookings
        WHERE employee_name LIKE %s
        OR room_name LIKE %s
        OR meeting_date LIKE %s
    """

    value = "%" + search_text + "%"

    cursor.execute(
        query,
        (value, value, value)
    )

    rows = cursor.fetchall()

    for row in rows:
        booking_table.insert(
            "",
            tk.END,
            values=row
        )

    cursor.close()
    connection.close()


# ================= DELETE BOOKING =================

def delete_booking():

    selected = booking_table.selection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Please select a booking."
        )
        return

    selected_item = booking_table.item(
        selected[0]
    )

    booking_id = selected_item["values"][0]

    confirm = messagebox.askyesno(
        "Confirm Delete",
        "Do you want to delete this booking?"
    )

    if not confirm:
        return

    connection = connect_database()

    if connection is None:
        return

    cursor = connection.cursor()

    cursor.execute(
        "DELETE FROM bookings WHERE id = %s",
        (booking_id,)
    )

    connection.commit()

    cursor.close()
    connection.close()

    messagebox.showinfo(
        "Success",
        "Booking deleted successfully."
    )

    show_bookings()


